# Copy to .env and fill in. Never commit .env. No value here is a real key.

# --- LLM provider: Vultr Serverless Inference ----------------------------
# auto: use Vultr when VULTR_INFERENCE_API_KEY is set, else the mock policy.
# vultr | mock: force one. Check your setup with: python scripts/check_inference.py
LLM_PROVIDER=auto
# Create a subscription in the Vultr portal: Products > Serverless > Inference.
# This key stays in the control plane; it is never passed to a sandbox.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Exact model id, or empty to auto-pick from GET /v1/models (speech, image,
# video and embedding models are never picked). These three worked end to end
# on Vultr Serverless Inference on 2026-11-27; check yours with scripts/doctor.py.
LLM_MODEL=deepseek-v4.1-flash-1017
# Second model, used if the primary is missing or keeps failing (empty = auto-pick another family).
LLM_FALLBACK_MODEL=qwen3.8-27b
# Vision model for screenshot verification: empty = auto-pick, "none" = off.
VISION_MODEL=mimo-v2.6-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1800
LLM_TIMEOUT_S=90
# Retries with exponential backoff on 429 / 5xx / timeouts.
LLM_MAX_RETRIES=2
# When Vultr is unreachable at the start of a live run and no recording
# matches: "mock" continues with the labelled mock policy, "none" fails.
LLM_FALLBACK=mock

# --- Sandbox ---------------------------------------------------------------
# auto | docker | mock. "auto" uses docker when the daemon and image exist.
SANDBOX_BACKEND=auto
SANDBOX_IMAGE=rwr-sandbox:latest
# Optional second isolation layer (install gVisor first): runsc
SANDBOX_RUNTIME=
# Optional: run sandboxes on a separate throwaway Vultr VM over SSH.
# SANDBOX_DOCKER_HOST=ssh://root@203.0.113.10
SANDBOX_DOCKER_HOST=
# Only for scripts/vultr_sandbox_vm.py, which creates/destroys that sandbox VM
# through the Vultr API. Never passed to a sandbox.
VULTR_API_KEY=
SANDBOX_VM_REGION=ams
SANDBOX_VM_PLAN=vc2-2c-4gb
SANDBOX_BROWSER_NETWORK=bridge
# Hosts the sandboxed browser may reach even if they resolve to private IPs.
SANDBOX_ALLOW_HOSTS=
SANDBOX_BROWSER_MEMORY=1g
SANDBOX_BROWSER_CPUS=1.0
SANDBOX_BROWSER_PIDS=512
SANDBOX_CODE_MEMORY=256m
SANDBOX_CODE_CPUS=0.5
SANDBOX_CODE_PIDS=64
SANDBOX_TOOL_TIMEOUT_S=45
SANDBOX_CODE_TIMEOUT_S=10

# --- Search ----------------------------------------------------------------
# auto = DuckDuckGo HTML from inside the sandbox, Wikipedia fallback (no key).
# brave = Brave Search API, called from the control plane so the key never
# enters the sandbox.
SEARCH_PROVIDER=auto
BRAVE_SEARCH_API_KEY=

# --- Agent -----------------------------------------------------------------
AGENT_MAX_STEPS=12
AGENT_RUN_TIMEOUT_S=420
MAX_CONCURRENT_RUNS=3
MAX_EVIDENCE_SCREENSHOTS=8

# --- Demo safety net (record / replay) -----------------------------------
# auto: live, but replay a recording if the live model is unavailable.
# replay: always replay when a recording matches. live: never replay.
DEMO_MODE=auto
# Multiplier on recorded latencies during replay (0 = instant).
REPLAY_SPEED=0.6
# Record every live run so it can be promoted with scripts/promote_run.py.
RECORD_RUNS=1

# --- Web app ---------------------------------------------------------------
# Public URL of this deployment (used for the hostile-page demo link).
PUBLIC_BASE_URL=http://localhost:8000
# Optional shared code needed to start runs on a public demo URL.
APP_ACCESS_CODE=
DATA_DIR=./data
