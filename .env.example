# Copy to .env and fill in. Never commit .env. No value here is a real key.

# --- Vultr Serverless Inference (required for real reasoning) ---------------
# Create a subscription in the Vultr portal: Products > Serverless > Inference.
# Without a key the app runs a deterministic mock policy (useful offline).
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Leave empty to auto-pick from GET /v1/models, or set an exact id from
# `python scripts/list_models.py`.
LLM_MODEL=
# Optional vision model for screenshot verification. Empty = auto-pick a
# vision-capable model if the list has one; "none" disables it.
VISION_MODEL=

# --- Sandbox ---------------------------------------------------------------
# auto | docker | mock. "auto" uses docker when the daemon and image exist.
SANDBOX_BACKEND=auto
SANDBOX_IMAGE=rwr-sandbox:latest
# Optional second isolation layer (install gVisor first): runsc
SANDBOX_RUNTIME=
# Optional: run sandboxes on a separate throwaway Vultr VM over SSH.
# SANDBOX_DOCKER_HOST=ssh://root@203.0.113.10
SANDBOX_DOCKER_HOST=
SANDBOX_BROWSER_NETWORK=bridge
# Hosts the sandboxed browser may reach even if they resolve to private IPs.
SANDBOX_ALLOW_HOSTS=
SANDBOX_BROWSER_MEMORY=1g
SANDBOX_BROWSER_CPUS=1.0
SANDBOX_BROWSER_PIDS=512
SANDBOX_CODE_MEMORY=256m
SANDBOX_CODE_CPUS=0.5
SANDBOX_CODE_PIDS=64
SANDBOX_TOOL_TIMEOUT_S=45
SANDBOX_CODE_TIMEOUT_S=10

# --- Search ----------------------------------------------------------------
# auto = DuckDuckGo HTML from inside the sandbox, Wikipedia fallback (no key).
# brave = Brave Search API, called from the control plane so the key never
# enters the sandbox.
SEARCH_PROVIDER=auto
BRAVE_SEARCH_API_KEY=

# --- Agent -----------------------------------------------------------------
AGENT_MAX_STEPS=12
AGENT_RUN_TIMEOUT_S=420
MAX_CONCURRENT_RUNS=3
MAX_EVIDENCE_SCREENSHOTS=8

# --- Web app ---------------------------------------------------------------
# Public URL of this deployment (used for the hostile-page demo link).
PUBLIC_BASE_URL=http://localhost:8000
# Optional shared code needed to start runs on a public demo URL.
APP_ACCESS_CODE=
DATA_DIR=./data
